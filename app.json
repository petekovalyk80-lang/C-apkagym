{
  "expo": {
    "name": "Anvil",
    "slug": "anvil",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "anvil",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#0E1512",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.petekovsoftware.anvil",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      },
      "buildNumber": "2"
    },
    "android": {
      "package": "com.petekovsoftware.anvil",
      "adaptiveIcon": {
        "backgroundColor": "#0E0A07",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/brand/anvil.png",
          "imageWidth": 288,
          "resizeMode": "contain",
          "backgroundColor": "#0E0A07"
        }
      ],
      "expo-image"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "4b4cc2aa-9895-4c5e-8303-62030f3dd438"
      }
    },
    "owner": "piotrekk80"
  }
}
